FROM golang:1.26.6-alpine AS builder

ARG VERSION=dev

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-X main.Version=${VERSION}" -o /telegram ./cmd/telegram/main.go


FROM alpine:3.18

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app

COPY --from=builder /telegram .

# Webhook listener port (webhook mode only; a reverse proxy terminates TLS externally).
EXPOSE 8083

CMD ["./telegram"]
