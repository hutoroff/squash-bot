          "expr": "prometheus_tsdb_head_series",
          "refId": "B",
          "legendFormat": "{{__name__}} {{service_key}} {{job}} {{exported_job}} {{outcome}} {{state}}"
        },
        {
          "expr": "up{job=\"prometheus\"}",
          "refId": "C",
          "legendFormat": "{{__name__}} {{service_key}} {{job}} {{exported_job}} {{outcome}} {{state}}"
