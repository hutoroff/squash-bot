{
  "apiVersion": 1,
  "policies": [
    {
      "orgId": 1,
      "receiver": "REPLACE_WITH_EXISTING_ROOT_CONTACT",
      "group_by": ["grafana_folder", "alertname"],
      "routes": [
        {
          "receiver": "squash-monitoring-telegram",
          "object_matchers": [["deployment", "=", "squash-bot"]],
          "group_by": ["deployment", "service_key", "alertname"],
          "group_wait": "30s",
          "group_interval": "5m",
          "repeat_interval": "1h"
        }
      ]
    }
  ]
}
