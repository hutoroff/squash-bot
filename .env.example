# Copy this file to .env and fill in the values below.
# All services share this file. docker-compose.yml (dev) and
# docker-compose.prod.yml (production) both read from it.

# ── Required ────────────────────────────────────────────────────────────────────

# Telegram bot token from https://t.me/BotFather
TELEGRAM_BOT_TOKEN=

# Bot username without @ (e.g. SquashBot). Required by the web service for the Login Widget.
TELEGRAM_BOT_NAME=

# Shared secret that authenticates internal calls between services.
# Minimum 32 characters — every service refuses to start otherwise.
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=

# Secret for signing squash-web session JWTs (HS256, 7-day expiry).
# Minimum 32 characters — the web service refuses to start otherwise.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────────

# Comma-separated Telegram user IDs granted the server-owner role at startup.
# Grant-only bootstrap seed: idempotent, and removing an ID here does NOT revoke
# an existing owner — manage ownership afterwards via the web UI's Users page.
# Set on the management service only; the web service no longer reads this var.
# SERVICE_ADMIN_IDS=123456789,987654321

# Management scheduler poll. Each job applies its own per-group time window.
# CRON_POLL=*/5 * * * *

# Management: days to keep audit events (daily cleanup) and how far back a past
# game stays eligible for result submission (group-local days).
# AUDIT_RETENTION_DAYS=365
# RESULT_WINDOW_DAYS=14

# TIMEZONE=UTC
# LOG_LEVEL=INFO

# Write rotated log files to $LOG_DIR/app.log in addition to stdout.
# docker-compose.prod.yml sets a per-service value itself.
# LOG_DIR=


# ── booking ──────────────────────────────────────────────────────────────────────

# URL of the booking service. When set, enables automatic court cancellation
# and auto-booking in management.
# SPORTS_BOOKING_SERVICE_URL=http://booking:8081

# AES-256-GCM key for encrypting venue booking credentials at rest.
# Required to enable the 🔑 Credentials feature in the venue edit menu.
# Generate with: openssl rand -hex 32
# CREDENTIALS_ENCRYPTION_KEY=

# How long a credential must sit out after a booking error before it is retried.
# Accepts Go duration strings (e.g. 24h, 12h30m). Default: 24h.
# CREDENTIAL_ERROR_COOLDOWN=24h

# Eversports facility ID (numeric, visible in the venue page URL on eversports.de).
# Required for GET /api/v1/eversports/matches and GET /api/v1/eversports/courts.
# EVERSPORTS_FACILITY_ID=76443

# Facility UUID for booking creation (POST /api/v1/eversports/matches).
# Find it in the facilityUuid field of the /checkout/api/payableitem/courtbooking
# request body in browser DevTools. Has a built-in default for the configured venue.
# EVERSPORTS_FACILITY_UUID=6266968c-b0fd-4115-ad3b-ae225cc880f1

# Facility slug (last segment of the venue URL on eversports.de).
# Required for GET /api/v1/eversports/matches and GET /api/v1/eversports/courts.
# The sport (squash) is fixed in code and is not configurable.
# EVERSPORTS_FACILITY_SLUG=squash-house-berlin-03

# ── Production deployment (docker-compose.prod.yml) ───────────────────────────
# The next three are REQUIRED for docker-compose.prod.yml (uncomment and fill in).
# The dev docker-compose.yml does not use them.

# REQUIRED (prod): PostgreSQL password. Generate with: openssl rand -hex 32
# Without it Postgres does not initialize; the dev compose file hardcodes its own.
# POSTGRES_PASSWORD=

# REQUIRED (prod): Docker Hub username — images are pulled as
# <username>/squash-management, <username>/squash-telegram-bot, etc.
# Without it every image reference is invalid.
# DOCKERHUB_USERNAME=

# REQUIRED (prod): Docker Hub read-only access token used by Watchtower to pull
# updated images. Create one at https://hub.docker.com/settings/security
# DOCKERHUB_TOKEN=

# Pin service image versions (default: stable, the tag set by Promote to Stable).
# MANAGEMENT_VERSION=stable
# TELEGRAM_VERSION=stable
# BOOKING_VERSION=stable
# WEB_VERSION=stable

# ── Telegram bot transport (webhook) ─────────────────────────────────────────────

# Full public HTTPS URL Telegram should POST updates to.
# When set, the bot uses webhook mode instead of long-polling.
# Leave empty (or unset) to use long-polling.
# TELEGRAM_WEBHOOK_URL=https://example.com/telegram/webhook

# Secret validated on every incoming webhook request via X-Telegram-Bot-Api-Secret-Token header.
# Required (minimum 16 characters) whenever TELEGRAM_WEBHOOK_URL is set — the
# telegram service refuses to start in webhook mode without it, since without a
# secret anyone who finds the URL could forge Updates and impersonate a group admin.
# Generate with: openssl rand -hex 32
# TELEGRAM_WEBHOOK_SECRET=

# Local plain-HTTP port the webhook listener binds to (webhook mode only).
# A TLS-terminating reverse proxy should forward TELEGRAM_WEBHOOK_URL traffic here.
# docker-compose.prod.yml maps TELEGRAM_SERVER_PORT to the telegram container's
# SERVER_PORT (default 8083). Do not set a bare SERVER_PORT in this shared file:
# every service reads it, so services started outside Compose would all bind it.
# TELEGRAM_SERVER_PORT=8083

# ── Local development only (not needed when using docker-compose) ────────────────

# Required for management when running outside Docker:
# DATABASE_URL=postgres://squash_bot:squash_bot@localhost:7432/squash_bot

# Required for telegram and web when running outside Docker:
# MANAGEMENT_SERVICE_URL=http://localhost:8080
