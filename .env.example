# Copy this file to .env and fill in the values below.
# All services share this file. docker-compose.yml (dev) and
# docker-compose.prod.yml (production) both read from it.

# ── Required ────────────────────────────────────────────────────────────────────

# Telegram bot token from https://t.me/BotFather
TELEGRAM_BOT_TOKEN=

# Bot username without @ (e.g. SquashBot). Required by the web service for the Login Widget.
TELEGRAM_BOT_NAME=

# Shared secret that authenticates internal calls between services.
# Minimum 32 characters — every service refuses to start otherwise.
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=

# Monitoring-only bearer used by every service's internal admin listener.
# Minimum 32 characters and must differ from INTERNAL_API_SECRET.
# Generate with: openssl rand -hex 32
MONITORING_TOKEN=

# Secret for signing squash-web session JWTs (HS256, 7-day expiry).
# Management verifies these for the owner-only manual booking-risk path.
# Must differ from INTERNAL_API_SECRET; minimum 32 characters. Without it,
# management leaves the booking-risk authorization route disabled.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────────

# Comma-separated Telegram user IDs granted the server-owner role at startup.
# Grant-only bootstrap seed: idempotent, and removing an ID here does NOT revoke
# an existing owner — manage ownership afterwards via the web UI's Users page.
# Set on the management service only; the web service no longer reads this var.
# SERVICE_ADMIN_IDS=123456789,987654321

# Cron schedules (evaluated in TIMEZONE below).
# CRON_DAY_BEFORE=0 20 * * *
# CRON_DAY_AFTER=0 8 * * *
# CRON_WEEKLY_REMINDER=0 10 * * 1

# TIMEZONE=UTC
# LOG_LEVEL=INFO

# Optional shadow service registration. Static application URLs remain active by default.
# DISCOVERY_MODE=static
# DISCOVERY_URL=http://management:8080
# Registry invocation requires a separately authorized staged cutover
# (docs/service-discovery-rollout-runbook.md). Production Compose uses this
# SAME DISCOVERY_MODE for management, Telegram and web: changing it globally
# switches all three at once. Keep it static for shadow registration; use an
# owner-reviewed per-service Compose override for each caller-class switch.
# Registry callers retain DISCOVERY_URL and their reviewed logical key, but
# clear THAT caller's static MANAGEMENT_SERVICE_URL or
# SPORTS_BOOKING_SERVICE_URL. Registry mode never falls back to static URLs.
# MANAGEMENT_SERVICE_KEY=management
# Docker Compose normally selects the instance IP from eth0. Outside Compose,
# set one explicit non-loopback IP when interface selection is ambiguous.
# DISCOVERY_NETWORK_INTERFACE=eth0
# SERVICE_ADVERTISE_HOST=10.0.0.10
# Management accepts advertised endpoints only from these networks.
# Production Compose defaults to 172.30.90.0/24, matching the one-time external
# bridge creation in monitoring/prometheus/README.md. Override only when the
# actual trusted bridge subnet differs. Development retains its own defaults.
# DISCOVERY_ALLOWED_CIDRS=172.30.90.0/24
# Required singleton inventory for monitoring; management appends the configured
# booking binding automatically. Set this JSON only to replace the Compose default.
# MONITORED_SERVICE_KEYS=[{"service_key":"management","contract":"management-api","major":1,"capabilities":["management.api"]},{"service_key":"telegram","contract":"telegram-transport","major":1},{"service_key":"web","contract":"web-api","major":1,"capabilities":["web.api"]}]


# ── booking ──────────────────────────────────────────────────────────────────────

# URL of the booking service. When set, enables automatic court cancellation
# and auto-booking in management.
# SPORTS_BOOKING_SERVICE_URL=http://booking:8081

# AES-256-GCM key for encrypting venue booking credentials at rest.
# Required to enable the 🔑 Credentials feature in the venue edit menu.
# Generate with: openssl rand -hex 32
# CREDENTIALS_ENCRYPTION_KEY=

# How long a credential must sit out after a booking error before it is retried.
# Accepts Go duration strings (e.g. 24h, 12h30m). Default: 24h.
# CREDENTIAL_ERROR_COOLDOWN=24h

# Eversports facility ID (numeric, visible in the venue page URL on eversports.de).
# Required for GET /api/v1/eversports/games and GET /api/v1/eversports/courts.
# EVERSPORTS_FACILITY_ID=76443

# Facility UUID for booking creation. Required; find it in the facilityUuid field
# of the /checkout/api/payableitem/courtbooking request body in browser DevTools.
# EVERSPORTS_FACILITY_UUID=6266968c-b0fd-4115-ad3b-ae225cc880f1

# Squash sport UUID used by reliable execution and verified import. Required.
# EVERSPORTS_SQUASH_SPORT_UUID=b388b6e6-69de-11e8-bdc6-02bd505aa7b2

# Facility slug from the venue URL on eversports.de. Required.
# EVERSPORTS_FACILITY_SLUG=squash-house-berlin-03

# Durable booking account-identity HMAC key. Required, exactly 32 random bytes
# encoded as 64 hex characters. Never rotate it without a controlled ledger migration.
# BOOKING_IDENTITY_KEY=$(openssl rand -hex 32)

# Stable logical key for this configured provider/facility/sport pool. Required.
# BOOKING_SERVICE_KEY=eversports.primary.squash

# Booking receives the shared MONITORING_TOKEN as BOOKING_MONITORING_SECRET in
# Compose for compatibility with its existing admin-listener configuration.

# Explicit acknowledgement that booking accepts keyed v2 mutations only and
# rejects keyless v1 mutation calls. Required when management enables booking
# through EITHER a static URL or registry binding; leave unset until the
# booking-reliability and discovery-rollout runbook gates have passed.
# BOOKING_RELIABLE_CUTOVER_ACK=keyed-v2-only

# Management's bounded foreground wait for accepted v2 operations and ledger
# polling interval. Pending work remains durable after this budget expires.
# MANAGEMENT_BOOKING_RESPONSE_WAIT=8s
# MANAGEMENT_BOOKING_STATUS_POLL=200ms

# Direct PostgreSQL URL used only by booking. Compose constructs this from
# POSTGRES_PASSWORD; set it explicitly only when running outside Compose.
# BOOKING_DATABASE_URL=postgres://squash_bot:squash_bot@localhost:7432/squash_bot?sslmode=disable

# Runtime defaults (Go duration syntax): response wait 20s, execution 90s,
# provider request 20s, finalization 5s, shutdown 100s, retention 90 days.
# BOOKING_HTTP_RESPONSE_WAIT=20s
# BOOKING_EXECUTION_TIMEOUT=90s
# BOOKING_PROVIDER_CALL_TIMEOUT=20s
# BOOKING_FINALIZATION_TIMEOUT=5s
# BOOKING_SHUTDOWN_TIMEOUT=100s
# BOOKING_RETENTION_INTERVAL=24h
# BOOKING_RETENTION_AGE=2160h
# BOOKING_RETENTION_BATCH_SIZE=100

# ── Production deployment (docker-compose.prod.yml) ───────────────────────────

# PostgreSQL password. Generate with: openssl rand -hex 32
# Used by docker-compose.prod.yml; the dev compose file has its own hardcoded value.
# POSTGRES_PASSWORD=

# Prometheus uses the same monitoring bearer as the services, read from an
# existing, private, absolute-path host file (not the .env or a YAML literal).
# Copy MONITORING_TOKEN to this file securely; never commit it.
# PROMETHEUS_TOKEN_FILE=/etc/squash-bot/monitoring_token
# Optional loopback query port and TSDB size cap; time retention is 15 days.
# PROMETHEUS_HOST_PORT=9090
# PROMETHEUS_RETENTION_SIZE=4GB

# Docker Hub username — images are pulled as <username>/squash-management, <username>/squash-telegram-bot, etc.
# DOCKERHUB_USERNAME=

# Docker Hub access token — used by Watchtower to pull updated images without hitting anonymous rate limits.
# Create a read-only token at https://hub.docker.com/settings/security
# DOCKERHUB_TOKEN=

# Pin service image versions (default: latest).
# MANAGEMENT_VERSION=latest
# TELEGRAM_VERSION=latest
# BOOKING_VERSION=latest
# WEB_VERSION=latest

# ── Telegram bot transport (webhook) ─────────────────────────────────────────────

# Full public HTTPS URL Telegram should POST updates to.
# When set, the bot uses webhook mode instead of long-polling.
# Leave empty (or unset) to use long-polling.
# TELEGRAM_WEBHOOK_URL=https://example.com/telegram/webhook

# Secret validated on every incoming webhook request via X-Telegram-Bot-Api-Secret-Token header.
# Required (minimum 16 characters) whenever TELEGRAM_WEBHOOK_URL is set — the
# telegram service refuses to start in webhook mode without it, since without a
# secret anyone who finds the URL could forge Updates and impersonate a group admin.
# Generate with: openssl rand -hex 32
# TELEGRAM_WEBHOOK_SECRET=

# Local plain-HTTP port the webhook listener binds to (webhook mode only).
# A TLS-terminating reverse proxy should forward TELEGRAM_WEBHOOK_URL traffic here.
# SERVER_PORT=8083

# ── Local development only (not needed when using docker-compose) ────────────────

# Required for management when running outside Docker:
# DATABASE_URL=postgres://squash_bot:squash_bot@localhost:7432/squash_bot

# Required for telegram when running outside Docker:
# MANAGEMENT_SERVICE_URL=http://localhost:8080
